  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t\xAB\u0410\u0493\u0430\xBB \u0434\u0435\u043F, \u049B\u0430\u0434\u0456\u0440
    \u0442\u04B1\u0442\u049B\u0430\u043D \u04B1\u0441\u0442\u0430\u0437\u044B \u0410\u0431\u0430\u0439
    \u0445\u0430\u049B\u044B\u043D\u0434\u0430 \u0428\u04D9\u043A\u04D9\u0440\u0456\u043C
    \u0431\u044B\u043B\u0430\u0439 \u0434\u0435\u043F \u0436\u0430\u0437\u0430\u0434\u044B:\n\r\n\t\xAB\u04D8\u043A\u0435\u043C\u0456\u0437\u0434\u0456\u04A3
    \u0431\u0456\u0440 \u0448\u0435\u0448\u0435\u0441\u0456\u043D\u0435\u043D \u0442\u0443\u0493\u0430\u043D
    \u0418\u0431\u0440\u0430\u04BB\u0438\u043C \u043C\u044B\u0440\u0437\u0430, \u049B\u0430\u0437\u0430\u049B
    \u0456\u0448\u0456\u043D\u0434\u0435 \u0410\u0431\u0430\u0439 \u0434\u0435\u043F
    \u0430\u0442\u0430\u0439\u0434\u044B, \u2013 \u0441\u043E\u043B \u043A\u0456\u0441\u0456
    \u043C\u04B1\u0441\u044B\u043B\u043C\u0430\u043D\u0448\u0430 \u04BB\u04D9\u043C
    \u043E\u0440\u044B\u0441\u0448\u0430 \u0493\u044B\u043B\u044B\u043C\u0493\u0430
    \u0436\u04AF\u0439\u0440\u0456\u043A, \u04BB\u04D9\u043C \u0410\u043B\u043B\u0430\u043D\u044B\u04A3
    \u0431\u0435\u0440\u0433\u0435\u043D \u0430\u049B\u044B\u043B\u044B \u0434\u0430
    \u0431\u04B1 \u049B\u0430\u0437\u0430\u049B\u0442\u0430\u043D \u0431\u04E9\u043B\u0435\u043A
    \u0434\u0430\u043D\u0430 \u043A\u0456\u0441\u0456 \u0435\u0434\u0456. \u0415\u0440\u0436\u0435\u0442\u043A\u0435\u043D
    \u0441\u043E\u04A3 \u0441\u043E\u043B \u043A\u0456\u0441\u0456\u0434\u0435\u043D
    \u0442\u0430\u0493\u044B\u043B\u044B\u043C \u0430\u043B\u044B\u043F, \u04D9\u0440
    \u0442\u04AF\u0440\u043B\u0456 \u043A\u0456\u0442\u0430\u043F\u0442\u0430\u0440\u044B\u043D
    \u043E\u049B\u044B\u043F, \u043D\u0430\u0441\u0438\u0445\u0430\u0442\u044B\u043D
    \u0442\u044B\u04A3\u0434\u0430\u043F, \u0430\u0437 \u0493\u0430\u043D\u0430 \u0493\u044B\u043B\u044B\u043C
    \u0441\u04D9\u0443\u043B\u0435\u0441\u0456\u043D \u0441\u0435\u0437\u0434\u0456\u043C.
    \u0418\u0431\u0440\u0430\u04BB\u0438\u043C \u043C\u044B\u0440\u0437\u0430\u043D\u044B\u04A3
    \u0442\u04B1\u0440\u0430\u0493\u044B \u049B\u0430\u0437\u0430\u049B \u0456\u0448\u0456
    \u0431\u043E\u043B\u0493\u0430\u043D\u0434\u044B\u049B\u0442\u0430\u043D, \u049B\u0430\u0434\u0456\u0440\u0456
    \u0430\u0437\u044B\u0440\u0430\u049B \u0431\u0456\u043B\u0456\u043D\u0434\u0456.
    \u0410\u043B\u0430\u0439 \u0431\u043E\u043B\u043C\u0430\u0493\u0430\u043D\u0434\u0430,
    \u0434\u04D9\u043D\u0456\u0448\u043C\u0430\u043D\u0434, \u0445\u04D9\u043A\u0456\u043C,
    \u0444\u0438\u043B\u043E\u0441\u043E\u0444 \u043A\u0456\u0441\u0456 \u0435\u0434\u0456\xBB
    \u2013 \u0434\u0435\u0439\u0434\u0456. \r\n"
